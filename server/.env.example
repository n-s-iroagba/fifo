# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
JWT_SECRET=your-strong-jwt-secret-min-32-chars

# ─── Frontend Origins (CORS) ──────────────────────────────────────────────────
# Comma-separated list — include every frontend domain that may hit this API.
# In production set to your actual deployed URLs (no trailing slash).
# Example: https://client.yourdomain.com,https://aveling.yourdomain.com
CLIENT_URL=https://your-client-frontend-url.com
AVELING_URL=https://your-aveling-frontend-url.com
CORS_ORIGINS=https://your-client-frontend-url.com,https://your-aveling-frontend-url.com

# ─── SMTP — Auth Channel (donotreply@...) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_AUTH_USER=your-auth-smtp-user@gmail.com
SMTP_AUTH_PASS=your-app-password
SMTP_AUTH_FROM="YourBrand Authentication" <donotreply@yourdomain.com>

# ─── SMTP — Info Channel (info@...) ──────────────────────────────────────────
SMTP_INFO_USER=your-info-smtp-user@gmail.com
SMTP_INFO_PASS=your-app-password
SMTP_INFO_FROM="YourBrand Infrastructure" <info@yourdomain.com>

# ─── Push Notifications (VAPID) ───────────────────────────────────────────────
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ─── Cloudinary (File Uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
